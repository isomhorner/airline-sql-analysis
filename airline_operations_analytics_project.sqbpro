<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="airline_operations_analytics.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="2438"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="0" parent="0"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="t100_segment" custom_title="0" dock_id="1" table="4,12:maint100_segment"/><dock_state state="000000ff00000000fd0000000100000002000003910000024ffc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000003910000013f00ffffff000002690000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="t100_segment" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="87"/><column index="2" value="63"/><column index="3" value="71"/><column index="4" value="119"/><column index="5" value="87"/><column index="6" value="300"/><column index="7" value="143"/><column index="8" value="55"/><column index="9" value="199"/><column index="10" value="127"/><column index="11" value="46"/><column index="12" value="199"/><column index="13" value="111"/><column index="14" value="46"/><column index="15" value="47"/><column index="16" value="47"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL Project Query Exploration">/*Query 1: Monthly Passenger Trend by Carrier*/
/*HAVING is after aggregation, and helps to keep carriers/months combos that
/*only have passenger counts in some months while getting rid of their months that
/*don't have any passenger counts... get rid of the 0count months without getting rid of the carrier altogether*/
SELECT UNIQUE_CARRIER_NAME, MONTH, SUM(PASSENGERS) AS total_passengers
FROM t100_segment
GROUP BY UNIQUE_CARRIER_NAME, MONTH
HAVING SUM(PASSENGERS) &gt; 0
ORDER BY UNIQUE_CARRIER_NAME, MONTH;


/*Query 2: picking a few carriers: one from US, one from Europe, one from Middle East/Asis
/*any seasonal overlap? month overlap? trend? stable months?*/
SELECT UNIQUE_CARRIER_NAME, MONTH, SUM(PASSENGERS) as total_passengers
FROM t100_segment
WHERE UNIQUE_CARRIER_NAME IN (&quot;United Air Lines Inc.&quot;, &quot;British Airways Plc&quot;, &quot;Emirates&quot;)
GROUP BY UNIQUE_CARRIER_NAME, MONTH
ORDER BY UNIQUE_CARRIER_NAME, MONTH;


/*Query 3: Aircraft utilization; passengers by MONTH
/* 614 boeing 737-800; 694 airbus a320, 637 boeing 777-300er, 889 boeing 787-900, 699 airbus a321*/
SELECT AIRCRAFT_TYPE, MONTH, SUM(PASSENGERS) as total_passengers
FROM t100_segment
WHERE AIRCRAFT_TYPE IN (614, 694, 637, 889, 699)
GROUP BY AIRCRAFT_TYPE, MONTH
ORDER BY AIRCRAFT_TYPE, MONTH;


/*&quot;market share&quot; Top 20* by aircraft type*/
SELECT AIRCRAFT_TYPE, SUM(PASSENGERS) AS total_passengers
FROM t100_segment
GROUP BY AIRCRAFT_TYPE
ORDER BY total_passengers DESC
LIMIT 20;
/*614 aircraf type is noticeably high in total passengers*/
/*because of aircraft type use, or carrier concentration+use?*/


/*&quot;market share&quot; Top 25 by carrier and their aircraft types*/
SELECT UNIQUE_CARRIER_NAME, AIRCRAFT_TYPE, SUM(PASSENGERS) AS total_passengers
FROM t100_segment
GROUP BY UNIQUE_CARRIER_NAME, AIRCRAFT_TYPE
ORDER BY total_passengers DESC
LIMIT 25;

/*the 614 is def driven by american airlines, and american airlines appears 4 times in the Top 10*/
/*the other popular aircraft however, are used throughout the other popular carriers*/
/*there seems there be two diff stories for why an aircraft would be popular: carrier-driven or aircraft-drive*/



/*what carriers are aircraft types being used by*/
/*distribution vs. concentration*/
SELECT AIRCRAFT_TYPE, COUNT(DISTINCT(UNIQUE_CARRIER_NAME)) AS carrier_count, SUM(PASSENGERS) AS total_passengers
FROM t100_segment
GROUP BY AIRCRAFT_TYPE
ORDER BY total_passengers DESC
LIMIT 20;
/*nope, 614 looks heavily adopted (but i'm going to make sure)*/
/*and then there are some interesting aircraft types that aren't heavily adopted, but generate high volume*/


/*looking at 614 and what carriers use it... is there anything else that is interesting before i move on*/
SELECT UNIQUE_CARRIER_NAME, SUM(PASSENGERS) AS total_passengers
FROM t100_segment
WHERE AIRCRAFT_TYPE = 614
GROUP BY UNIQUE_CARRIER_NAME
ORDER BY total_passengers DESC;


/*now doing the same with the unusual outliers: low adoption but high volume*/
SELECT UNIQUE_CARRIER_NAME, SUM(PASSENGERS) AS total_passengers
FROM t100_segment
WHERE AIRCRAFT_TYPE = 839
GROUP BY UNIQUE_CARRIER_NAME
ORDER BY total_passengers DESC;
/*bigtime United, then compania panamena, then alaska airlines, then aeromexico*/


SELECT UNIQUE_CARRIER_NAME, SUM(PASSENGERS) AS total_passengers
FROM t100_segment
WHERE AIRCRAFT_TYPE = 888
GROUP BY UNIQUE_CARRIER_NAME
ORDER BY total_passengers DESC;
/*Delta + United vs small alaska airlines*/


SELECT UNIQUE_CARRIER_NAME, SUM(PASSENGERS) AS total_passengers
FROM t100_segment
WHERE AIRCRAFT_TYPE = 339
GROUP BY UNIQUE_CARRIER_NAME
ORDER BY total_passengers DESC;
/*damn, delta*/

/*United and Delta are consistently in the lists of '2-4 carriers that use this aircraft and have high volume'*/
/*839 Boeing 737 Max 9 ... 888 Boeing 737-900ER ... 339 Airbus A330-900*/</sql><sql name="SQL Project Queries*">/* QUERY 1*/
SELECT MONTH, SUM(PASSENGERS) AS total_passengers
FROM t100_segment
GROUP BY MONTH
ORDER BY MONTH;


/*QUERY 2 : TOP CARRIERS BY PASSENGER VOLUME*/
SELECT UNIQUE_CARRIER_NAME, SUM(PASSENGERS) AS total_passengers
FROM t100_segment
GROUP BY UNIQUE_CARRIER_NAME
HAVING SUM(PASSENGERS) &gt; 0
ORDER BY total_passengers DESC
LIMIT 15;


/*QUERY 3 : TOP AIRCRAFT TYPES BY PASSENGERS*/
SELECT AIRCRAFT_TYPE, SUM(PASSENGERS) AS total_passengers
FROM t100_segment
GROUP BY AIRCRAFT_TYPE
HAVING SUM(PASSENGERS) &gt; 0
ORDER BY total_passengers DESC
LIMIT 20;



/*query 4: AIRCRAFT ADOPTION vs passenger volume*/
SELECT AIRCRAFT_TYPE, COUNT(DISTINCT(UNIQUE_CARRIER_NAME)) AS carrier_count, SUM(PASSENGERS) AS total_passengers
FROM t100_segment
GROUP BY AIRCRAFT_TYPE
HAVING SUM(PASSENGERS) &gt; 0
ORDER BY total_passengers DESC
LIMIT 20;


/*QUERY 5: CARRIERS AND THEIR AC TYPE, BY PASSENGER VOLUME*/
SELECT UNIQUE_CARRIER_NAME, AIRCRAFT_TYPE, SUM(PASSENGERS) AS total_passengers
FROM t100_segment
GROUP BY UNIQUE_CARRIER_NAME, AIRCRAFT_TYPE
HAVING SUM(PASSENGERS) &gt; 0
ORDER BY total_passengers DESC
LIMIT 25;</sql><current_tab id="1"/></tab_sql></sqlb_project>
